rules_version = '2';

// Règles Firestore de MOSN.
// Principe : le client lit/écrit le minimum ; tout ce qui est privilégié
// (rôles, bannissement, modération) passe par les Netlify Functions avec
// firebase-admin, qui contourne ces règles.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      // Custom claim posé par la fonction admin-set-role
      return signedIn() && request.auth.token.admin == true;
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // ── Profils utilisateurs ─────────────────────────────────────────
    match /users/{uid} {
      allow read: if signedIn();
      // Création de son propre profil à l'inscription.
      // Les champs sensibles (role, banned) ne sont pas modifiables ici.
      allow create: if isSelf(uid)
        && !("role" in request.resource.data)
        && !("banned" in request.resource.data);
      allow update: if isSelf(uid)
        && !request.resource.data.diff(resource.data).affectedKeys()
            .hasAny(["role", "banned"]);
      allow delete: if false; // suppression via fonction admin uniquement
    }

    // ── Posts ────────────────────────────────────────────────────────
    match /posts/{postId} {
      allow read: if true; // feed public
      allow create: if signedIn()
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 2000;
      allow update, delete: if isAdmin()
        || (signedIn() && resource.data.authorId == request.auth.uid);

      // ── Commentaires ───────────────────────────────────────────────
      match /comments/{commentId} {
        allow read: if true;
        allow create: if signedIn()
          && request.resource.data.authorId == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 1000;
        allow update, delete: if isAdmin()
          || (signedIn() && resource.data.authorId == request.auth.uid);
      }
    }

    // ── Signalements ─────────────────────────────────────────────────
    // Créés via la fonction report-content ; lisibles par les admins.
    match /reports/{reportId} {
      allow read: if isAdmin();
      allow write: if false; // écriture serveur uniquement
    }
  }
}
