# Astuce : pas besoin de remplir ce fichier à la main.
# - En ligne : déployez le site, l'assistant d'installation s'affiche et
#   génère ce fichier pour vous.
# - En local : lancez `npm run setup`.

# ── Site ────────────────────────────────────────────────────────────
VITE_SITE_NAME=
# test | dev | preprod | production
# (en dev/test, la page de connexion affiche un bouton de connexion anonyme)
VITE_SITE_ENV=production

# ── Frontend (exposé au navigateur, préfixe VITE_) ──────────────────
# Console Firebase → Paramètres du projet → Vos applications → Config
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# ── Compte administrateur ───────────────────────────────────────────
# Utilisé une seule fois par /api/bootstrap-admin pour créer le compte.
# Supprimez ADMIN_PASSWORD une fois l'admin créé.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ── Netlify Functions (secrets serveur, JAMAIS de préfixe VITE_) ────
# Console Firebase → Paramètres → Comptes de service → Générer une clé privée.
# Coller ici le JSON complet du service account, sur une seule ligne.
FIREBASE_SERVICE_ACCOUNT=
