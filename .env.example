# Astuce : pas besoin de remplir ce fichier à la main.
# - En ligne : déployez le site, l'assistant d'installation s'affiche et
#   génère ce fichier pour vous.
# - En local : lancez `npm run setup`.

# ── Site ────────────────────────────────────────────────────────────
VITE_SITE_NAME=
# test | dev | preprod | production
# (en dev/test, la page de connexion affiche un bouton de connexion anonyme)
VITE_SITE_ENV=production

# ── Frontend (exposé au navigateur, préfixe VITE_) ──────────────────
# Console Firebase → Paramètres du projet → Vos applications → Config
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# ── Compte administrateur ───────────────────────────────────────────
# Utilisé une seule fois par /api/bootstrap-admin pour créer le compte.
# Supprimez ADMIN_PASSWORD une fois l'admin créé.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ── Réglages INITIAUX du site, appliqués par /api/bootstrap-admin ; ─
# ensuite un admin les modifie depuis /admin/settings, sans redéploiement.
# Hébergement d'images (Firebase Storage, plan Blaze requis) :
ENABLE_IMAGES=false
# Design : indigo | ocean | forest | sunset | rose | midnight | paper | mono | violet | citrus
SITE_THEME=indigo
# Langue : fr | en | es | zh | pt | ja | ko
SITE_LANGUAGE=fr
# Fil visible sans être connecté : true | false
PUBLIC_FEED=true
# Posts par page : 10 | 20 | 50 | 100
PAGE_SIZE=20

# ── Netlify Functions (secrets serveur, JAMAIS de préfixe VITE_) ────
# Console Firebase → Paramètres → Comptes de service → Générer une clé privée.
# Coller le CONTENU COMPLET du fichier .json téléchargé (il commence par "{"),
# sur une seule ligne — ou sa version encodée en base64.
FIREBASE_SERVICE_ACCOUNT=

# Optionnel : uniquement si votre base Firestore a un ID personnalisé
# (créée hors console Firebase). Par défaut : (default).
# FIRESTORE_DATABASE_ID=
